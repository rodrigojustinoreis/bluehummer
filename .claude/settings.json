{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "WebFetch", "WebSearch",
      "Bash(*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Read(./.env*)"
    ]
  }
}
